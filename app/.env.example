# Copy to .env.local and fill in what you need. The app runs without any of this.
# Real model turns:
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Force the offline provider:
# AGENT_PROVIDER=mock
# Where sandboxes are created (keep outside any git repository):
# PROJECTS_ROOT=D:\foundry-projects
